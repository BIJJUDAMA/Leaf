attribute [local irreducible] compressBlockNat sha256BlocksNat

private theorem sha256BlocksNat_1 (padded : ByteArray) (st : Sha256NatState) :
    sha256BlocksNat padded 1 st = compressBlockNat st (fun j => padded.get! j) := by
  unfold sha256BlocksNat
  change compressBlockNat st (fun j => padded.get! (0 * 64 + j)) = _
  simp

private theorem sha256BlocksNat_2 (padded : ByteArray) (st : Sha256NatState) :
    sha256BlocksNat padded 2 st =
      compressBlockNat (compressBlockNat st (fun j => padded.get! j))
        (fun j => padded.get! (64 + j)) := by
  unfold sha256BlocksNat
  change compressBlockNat (compressBlockNat st (fun j => padded.get! (0 * 64 + j)))
    (fun j => padded.get! (1 * 64 + j)) = _
  simp

private def v448Bytes : ByteArray := ByteArray.mk #[
  97, 98, 99, 100, 98, 99, 100, 101, 99, 100, 101, 102, 100, 101, 102, 103,
  101, 102, 103, 104, 102, 103, 104, 105, 103, 104, 105, 106, 104, 105, 106, 107,
  105, 106, 107, 108, 106, 107, 108, 109, 107, 108, 109, 110, 108, 109, 110, 111,
  109, 110, 111, 112, 110, 111, 112, 113
]

private theorem v448_bytes_eq :
    "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".toUTF8 = v448Bytes := by
  decide

private def v448PadByte (j : Nat) : UInt8 :=
  if j < 56 then v448Bytes.get! j
  else if j = 56 then 0x80
  else if j < 126 then 0
  else if j = 126 then 1
  else 192

private theorem byteArray_getBang_eq (b : ByteArray) (i : Nat) (h : i < b.size) :
    b.get! i = b[i] := by
  change b.data[i]! = b.data[i]
  exact getElem!_pos b.data i h

private theorem v448_tail_eq :
    uint64ToBEBytes (v448Bytes.size.toUInt64 * 8) = ByteArray.mk #[0, 0, 0, 0, 0, 0, 1, 192] := by
  decide

private theorem v448_pad_at (j : Nat) (hj : j < 128) :
    (sha256PadBytes v448Bytes).get! j = v448PadByte j := by
  have hvsize : v448Bytes.size = 56 := rfl
  have hzcount : sha256ZeroCount v448Bytes.size = 63 := by rw [hvsize]; decide
  have hzsize : (ByteArray.mk (Array.replicate (sha256ZeroCount v448Bytes.size) 0)).size = 63 := by
    change (Array.replicate (sha256ZeroCount v448Bytes.size) (0 : UInt8)).size = 63
    rw [Array.size_replicate, hzcount]
  have htsize : (uint64ToBEBytes (v448Bytes.size.toUInt64 * 8)).size = 8 :=
    uint64ToBEBytes_size _
  have h1size : (ByteArray.mk #[0x80]).size = 1 := rfl
  have h2size : (v448Bytes ++ ByteArray.mk #[0x80]).size = 57 := by
    rw [ByteArray.size_append, hvsize, h1size]
  have h3size : (v448Bytes ++ ByteArray.mk #[0x80] ++ ByteArray.mk (Array.replicate (sha256ZeroCount v448Bytes.size) 0)).size = 120 := by
    rw [ByteArray.size_append, h2size, hzsize]
  have hzcount56 : sha256ZeroCount 56 = 63 := by decide
  have hfull : (sha256PadBytes v448Bytes).size = 128 := by
    rw [sha256PadBytes_size]
    unfold sha256PaddedLen
    rw [hvsize, hzcount56]
  rw [byteArray_getBang_eq (sha256PadBytes v448Bytes) j (by omega)]
  unfold sha256PadBytes
  dsimp only
  by_cases h120 : j < 120
  · rw [ByteArray.getElem_append_left (by rw [h3size]; exact h120)]
    by_cases h57 : j < 57
    · rw [ByteArray.getElem_append_left (by rw [h2size]; exact h57)]
      by_cases h56 : j < 56
      · rw [ByteArray.getElem_append_left (by rw [hvsize]; exact h56)]
        rw [← byteArray_getBang_eq v448Bytes j (by omega)]
        simp [v448PadByte, h56]
      · have hj56 : j = 56 := by omega
        subst hj56
        rw [ByteArray.getElem_append_right (by rw [hvsize]; exact Nat.le_refl _)]
        have hidx0 : 56 - v448Bytes.size = 0 := by rw [hvsize]
        simp only [hidx0]
        change (#[0x80] : Array UInt8)[0] = v448PadByte 56
        decide
    · rw [ByteArray.getElem_append_right (by rw [h2size]; omega)]
      have hidx : j - (v448Bytes ++ ByteArray.mk #[0x80]).size < 63 := by rw [h2size]; omega
      have hrep : (ByteArray.mk (Array.replicate (sha256ZeroCount v448Bytes.size) 0))[j - (v448Bytes ++ ByteArray.mk #[0x80]).size]'(by
          change j - (v448Bytes ++ ByteArray.mk #[0x80]).size < (ByteArray.mk (Array.replicate (sha256ZeroCount v448Bytes.size) 0)).size
          rw [hzsize]; exact hidx) = (0 : UInt8) := by
        change (Array.replicate (sha256ZeroCount v448Bytes.size) (0 : UInt8))[j - (v448Bytes ++ ByteArray.mk #[0x80]).size]'(by
          rw [Array.size_replicate, hzcount]; exact hidx) = 0
        exact Array.getElem_replicate _
      rw [hrep]
      simp [v448PadByte, show ¬ j < 56 by omega, show j ≠ 56 by omega, show j < 126 by omega]
  · rw [ByteArray.getElem_append_right (by rw [h3size]; omega)]
    have hj_cases : j = 120 ∨ j = 121 ∨ j = 122 ∨ j = 123 ∨ j = 124 ∨ j = 125 ∨ j = 126 ∨ j = 127 := by omega
    rcases hj_cases with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · simp only [h3size, v448_tail_eq]; change (#[0, 0, 0, 0, 0, 0, 1, 192] : Array UInt8)[0] = v448PadByte 120; decide
    · simp only [h3size, v448_tail_eq]; change (#[0, 0, 0, 0, 0, 0, 1, 192] : Array UInt8)[1] = v448PadByte 121; decide
    · simp only [h3size, v448_tail_eq]; change (#[0, 0, 0, 0, 0, 0, 1, 192] : Array UInt8)[2] = v448PadByte 122; decide
    · simp only [h3size, v448_tail_eq]; change (#[0, 0, 0, 0, 0, 0, 1, 192] : Array UInt8)[3] = v448PadByte 123; decide
    · simp only [h3size, v448_tail_eq]; change (#[0, 0, 0, 0, 0, 0, 1, 192] : Array UInt8)[4] = v448PadByte 124; decide
    · simp only [h3size, v448_tail_eq]; change (#[0, 0, 0, 0, 0, 0, 1, 192] : Array UInt8)[5] = v448PadByte 125; decide
    · simp only [h3size, v448_tail_eq]; change (#[0, 0, 0, 0, 0, 0, 1, 192] : Array UInt8)[6] = v448PadByte 126; decide
    · simp only [h3size, v448_tail_eq]; change (#[0, 0, 0, 0, 0, 0, 1, 192] : Array UInt8)[7] = v448PadByte 127; decide

private theorem readWordBENat_congr {f g : Nat → UInt8} {off : Nat}
    (h0 : f off = g off) (h1 : f (off + 1) = g (off + 1))
    (h2 : f (off + 2) = g (off + 2)) (h3 : f (off + 3) = g (off + 3)) :
    readWordBENat f off = readWordBENat g off := by
  unfold readWordBENat
  rw [h0, h1, h2, h3]

/-- Kernel-checked NIST FIPS 180-4 test vector for `""` (empty string). -/
theorem sha256_empty_vec :
    sha256 "".toUTF8 = ⟨ByteArray.mk #[
      0xe3, 0xb0, 0xc4, 0x42, 0x98, 0xfc, 0x1c, 0x14,
      0x9a, 0xfb, 0xf4, 0xc8, 0x99, 0x6f, 0xb9, 0x24,
      0x27, 0xae, 0x41, 0xe4, 0x64, 0x9b, 0x93, 0x4c,
      0xa4, 0x95, 0x99, 0x1b, 0x78, 0x52, 0xb8, 0x55
    ], rfl⟩ := by
  rw [sha256_eq_natEval]
  unfold sha256NatEval
  dsimp only
  have hn : (sha256PadBytes "".toUTF8).size / 64 = 1 := rfl
  rw [hn, sha256BlocksNat_1]
  have hblk : compressBlockNat Sha256NatState.init (fun j => (sha256PadBytes "".toUTF8).get! j) = empty_b0_out := by
    refine compressBlockNat_of_trace Sha256NatState.init empty_b0_out _ empty_b0_w0 empty_b0_w64 empty_b0_ws empty_b0_rs
      (by rw [array_range_16, List.map_toArray]; decide)
      (by repeat (first | exact True.intro | refine ⟨rfl, ?_⟩))
      rfl rfl
      (by repeat (first | exact True.intro | refine ⟨rfl, ?_⟩))
      rfl rfl
  rw [hblk]
  decide

/-- Kernel-checked NIST FIPS 180-4 test vector for `"abc"`. -/
theorem sha256_abc_vec :
    sha256 "abc".toUTF8 = ⟨ByteArray.mk #[
      0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
      0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,
      0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c,
      0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad
    ], rfl⟩ := by
  rw [sha256_eq_natEval]
  unfold sha256NatEval
  dsimp only
  have hn : (sha256PadBytes "abc".toUTF8).size / 64 = 1 := rfl
  rw [hn, sha256BlocksNat_1]
  have hblk : compressBlockNat Sha256NatState.init (fun j => (sha256PadBytes "abc".toUTF8).get! j) = abc_b0_out := by
    refine compressBlockNat_of_trace Sha256NatState.init abc_b0_out _ abc_b0_w0 abc_b0_w64 abc_b0_ws abc_b0_rs
      (by rw [array_range_16, List.map_toArray]; decide)
      (by repeat (first | exact True.intro | refine ⟨rfl, ?_⟩))
      rfl rfl
      (by repeat (first | exact True.intro | refine ⟨rfl, ?_⟩))
      rfl rfl

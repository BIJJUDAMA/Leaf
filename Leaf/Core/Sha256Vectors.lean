import Leaf.Core.Sha256Eval

namespace Leaf.Core

private def expandScheduleChainOk : Nat → Array Nat → List (Array Nat) → Prop
  | _, _, [] => True
  | t, w, next :: rest =>
    expandScheduleNatLoop t 4 w = next ∧ expandScheduleChainOk (t + 4) next rest

private theorem getLastD_cons {α : Type} (w x : α) :
    ∀ (xs : List α), (x :: xs).getLastD w = xs.getLastD x
  | [] => rfl
  | _ :: _ => rfl

private theorem expandScheduleNatLoop_chain :
    ∀ (ws : List (Array Nat)) (t : Nat) (w : Array Nat),
      expandScheduleChainOk t w ws →
      expandScheduleNatLoop t (4 * ws.length) w = ws.getLastD w
  | [], t, w, _ => by simp [expandScheduleNatLoop]
  | next :: rest, t, w, ⟨hhead, htail⟩ => by
    have hmul : 4 * (next :: rest).length = 4 + 4 * rest.length := by
      simp [List.length_cons, Nat.mul_succ, Nat.add_comm]
    rw [hmul, expandScheduleNatLoop_add, hhead, getLastD_cons w next rest]
    exact expandScheduleNatLoop_chain rest (t + 4) next htail

private def compressRoundsChainOk (w : Array Nat) :
    Nat → Sha256NatState → List Sha256NatState → Prop
  | _, _, [] => True
  | t, st, next :: rest =>
    compressRoundsNatLoop t 2 w st = next ∧ compressRoundsChainOk w (t + 2) next rest

private theorem compressRoundsNatLoop_chain (w : Array Nat) :
    ∀ (rs : List Sha256NatState) (t : Nat) (st : Sha256NatState),
      compressRoundsChainOk w t st rs →
      compressRoundsNatLoop t (2 * rs.length) w st = rs.getLastD st
  | [], t, st, _ => by simp [compressRoundsNatLoop]
  | next :: rest, t, st, ⟨hhead, htail⟩ => by
    have hmul : 2 * (next :: rest).length = 2 + 2 * rest.length := by
      simp [List.length_cons, Nat.mul_succ, Nat.add_comm]
    rw [hmul, compressRoundsNatLoop_add, hhead, getLastD_cons st next rest]
    exact compressRoundsNatLoop_chain w rest (t + 2) next htail

private theorem compressBlockNat_of_trace
    (st out : Sha256NatState) (byteAt : Nat → UInt8)
    (w0 w64 : Array Nat) (ws : List (Array Nat)) (rs : List Sha256NatState)
    (hw0 : (Array.range 16).map (fun i => readWordBENat byteAt (i * 4)) = w0)
    (hws : expandScheduleChainOk 16 w0 ws)
    (hwsLen : ws.length = 12)
    (hw64 : ws.getLastD w0 = w64)
    (hrs : compressRoundsChainOk w64 0 st rs)
    (hrsLen : rs.length = 32)
    (hout :
      (⟨addN st.h0 (rs.getLastD st).h0, addN st.h1 (rs.getLastD st).h1,
        addN st.h2 (rs.getLastD st).h2, addN st.h3 (rs.getLastD st).h3,
        addN st.h4 (rs.getLastD st).h4, addN st.h5 (rs.getLastD st).h5,
        addN st.h6 (rs.getLastD st).h6, addN st.h7 (rs.getLastD st).h7⟩ : Sha256NatState) = out) :
    compressBlockNat st byteAt = out := by
  have hsched : buildScheduleNat byteAt = w64 := by
    unfold buildScheduleNat
    dsimp only
    rw [hw0]
    have h48 : (48 : Nat) = 4 * ws.length := by rw [hwsLen]
    rw [h48, expandScheduleNatLoop_chain ws 16 w0 hws, hw64]
  have hrounds : compressRoundsNatLoop 0 64 w64 st = rs.getLastD st := by
    have h64 : (64 : Nat) = 2 * rs.length := by rw [hrsLen]
    rw [h64, compressRoundsNatLoop_chain w64 rs 0 st hrs]
  unfold compressBlockNat
  dsimp only
  rw [hsched, hrounds]
  exact hout

